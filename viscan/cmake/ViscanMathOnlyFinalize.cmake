# viscan fork of PROJ: runs at the end of the top-level configure step
# (deferred from ViscanMathOnly.cmake), when all targets and tests exist.

# ---------------------------------------------------------------------------
# 1. Replace the database, network and GeoPackage sources by stubs.
# ---------------------------------------------------------------------------
set(_viscan_removed_sources
  iso19111/factory.cpp              # DatabaseContext, AuthorityFactory
  networkfilemanager.cpp            # CDN access, grid cache (SQLite)
  sqlite3_utils.cpp                 # SQLite helpers
  transformations/tinshift_gpkg.cpp # TIN models stored in GeoPackage (SQLite)
)
get_target_property(_viscan_sources proj SOURCES)
foreach(_src IN LISTS _viscan_removed_sources)
  list(FIND _viscan_sources "${_src}" _idx)
  if(_idx EQUAL -1)
    message(FATAL_ERROR
      "viscan: upstream source '${_src}' is no longer part of target proj. "
      "Update ${CMAKE_CURRENT_LIST_FILE} and the stubs in viscan/src.")
  endif()
  list(REMOVE_ITEM _viscan_sources "${_src}")
endforeach()
set_property(TARGET proj PROPERTY SOURCES ${_viscan_sources})

target_sources(proj PRIVATE
  ${VISCAN_DIR}/src/viscan_database_stubs.cpp
  ${VISCAN_DIR}/src/viscan_network_stubs.cpp
  ${VISCAN_DIR}/src/viscan_tinshift_gpkg_stubs.cpp
  ${VISCAN_DIR}/src/viscan_printf.cpp
)
# Stand-in for <sqlite3.h>: lets upstream sources compile without SQLite.
target_include_directories(proj BEFORE PRIVATE ${VISCAN_DIR}/src/sqlite3_stub)
target_compile_definitions(proj PRIVATE VISCAN_MATH_ONLY)

# ---------------------------------------------------------------------------
# 2. Do not link SQLite.
# ---------------------------------------------------------------------------
foreach(_prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
  get_target_property(_libs proj ${_prop})
  if(_libs)
    list(REMOVE_ITEM _libs SQLite3::SQLite3 "$<LINK_ONLY:SQLite3::SQLite3>")
    set_property(TARGET proj PROPERTY ${_prop} ${_libs})
  endif()
endforeach()

# ---------------------------------------------------------------------------
# 3. Tests
# ---------------------------------------------------------------------------
if(NOT BUILD_TESTING)
  return()
endif()

# Test data, as upstream data/CMakeLists.txt prepares it, but without proj.db.
set(_for_tests "${PROJ_BINARY_DIR}/data/for_tests")
file(MAKE_DIRECTORY "${_for_tests}/tests" "${_for_tests}/dir with space")
foreach(_f GL27 nad27 nad83 ITRF2000 proj.ini)
  configure_file(${PROJ_SOURCE_DIR}/data/${_f} ${_for_tests}/${_f} COPYONLY)
endforeach()
file(GLOB _data_tests ${PROJ_SOURCE_DIR}/data/tests/*)
foreach(_f IN LISTS _data_tests)
  get_filename_component(_name ${_f} NAME)
  configure_file(${_f} ${_for_tests}/tests/${_name} COPYONLY)
endforeach()
foreach(_f alaska BETA2007.gsb conus MD ntf_r93.gsb ntv1_can.dat)
  configure_file(${PROJ_SOURCE_DIR}/data/tests/${_f} ${_for_tests}/${_f} COPYONLY)
endforeach()
configure_file(${PROJ_SOURCE_DIR}/data/tests/egm96_15_downsampled.gtx
               ${_for_tests}/egm96_15.gtx COPYONLY)
configure_file(${PROJ_SOURCE_DIR}/data/tests/ntv2_0_downsampled.gsb
               ${_for_tests}/ntv2_0.gsb COPYONLY)
configure_file(${PROJ_SOURCE_DIR}/data/tests/conus
               "${_for_tests}/dir with space/myconus" COPYONLY)

# viscan's own tests: guarantees of the math-only build.
include(${VISCAN_DIR}/test/viscan_tests.cmake)

# Upstream tests that need the removed functionality are not run. The list
# is generated by viscan/tools/update_test_exclusions.py.
if(VISCAN_IGNORE_TEST_EXCLUSIONS)
  message(STATUS "viscan: test exclusions ignored, all upstream tests run")
  return()
endif()
if(CMAKE_VERSION VERSION_LESS 3.28)
  message(WARNING "viscan: CMake >= 3.28 is needed to apply the test "
                  "exclusions; tests needing the database will fail.")
  return()
endif()

# Map test name -> directory that defines it.
function(_viscan_collect_test_dirs dir)
  get_property(_tests DIRECTORY ${dir} PROPERTY TESTS)
  foreach(_t IN LISTS _tests)
    set_property(GLOBAL PROPERTY _VISCAN_TEST_DIR_${_t} ${dir})
  endforeach()
  get_property(_subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
  foreach(_d IN LISTS _subdirs)
    _viscan_collect_test_dirs(${_d})
  endforeach()
endfunction()
_viscan_collect_test_dirs(${PROJ_SOURCE_DIR})

include(${VISCAN_DIR}/test/excluded_tests.cmake)

foreach(_t IN LISTS VISCAN_DISABLED_TESTS)
  get_property(_dir GLOBAL PROPERTY _VISCAN_TEST_DIR_${_t})
  if(NOT _dir)
    message(WARNING "viscan: excluded test '${_t}' does not exist (stale "
                    "entry in viscan/test/excluded_tests.cmake)")
    continue()
  endif()
  set_property(TEST ${_t} DIRECTORY ${_dir} PROPERTY DISABLED TRUE)
endforeach()

foreach(_t IN LISTS VISCAN_GTEST_FILTERED_TESTS)
  get_property(_dir GLOBAL PROPERTY _VISCAN_TEST_DIR_${_t})
  if(NOT _dir)
    message(WARNING "viscan: filtered test '${_t}' does not exist (stale "
                    "entry in viscan/test/excluded_tests.cmake)")
    continue()
  endif()
  list(JOIN VISCAN_GTEST_EXCLUDES_${_t} ":" _filter)
  set_property(TEST ${_t} DIRECTORY ${_dir} APPEND PROPERTY ENVIRONMENT
               "GTEST_FILTER=-${_filter}")
endforeach()
